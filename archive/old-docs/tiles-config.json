{
  "tiles": [
    {
      "id": "demo-mode",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "toggleDemo",
      "color": "#ffff00",
      "icon": "~"
    },
    {
      "id": "file-input",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "loadFile",
      "color": "#00ffff",
      "icon": "♪"
    },
    {
      "id": "jack-input",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "toggleJack",
      "color": "#ff00ff",
      "icon": "J"
    },
    {
      "id": "audio-output",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "toggleOutput",
      "color": "#00ff00",
      "icon": "→"
    },
    {
      "id": "wave-speed",
      "type": "slider",
      "width": 120,
      "height": 60,
      "min": 0.05,
      "max": 0.3,
      "default": 0.15,
      "variable": "waveSpeed",
      "color": "#00e5ff"
    },
    {
      "id": "damping",
      "type": "slider",
      "width": 120,
      "height": 60,
      "min": 0.001,
      "max": 0.05,
      "default": 0.01,
      "variable": "damping",
      "color": "#00e5ff"
    },
    {
      "id": "gain",
      "type": "slider",
      "width": 120,
      "height": 60,
      "min": 0.5,
      "max": 5.0,
      "default": 3.0,
      "variable": "actuatorGain",
      "color": "#00e5ff"
    },
    {
      "id": "clear-all",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "clearAll",
      "color": "#ff5555",
      "icon": "×"
    },
    {
      "id": "fullscreen",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "toggleFullscreen",
      "color": "#ffffff",
      "icon": "⛶"
    },
    {
      "id": "mini-membrane",
      "type": "mini-membrane",
      "width": 120,
      "height": 120,
      "resizable": true
    }
  ],
  "actuatorProperties": {
    "size": {
      "min": 1.0,
      "max": 5.0,
      "default": 2.0
    },
    "height": {
      "min": 0.0,
      "max": 20.0,
      "default": 2.0
    },
    "transparency": {
      "min": 0.3,
      "max": 1.0,
      "default": 0.7
    }
  },
  "membraneGradient": {
    "range": [-10, 10],
    "colorScale": "interpolateSpectral"
  }
}
