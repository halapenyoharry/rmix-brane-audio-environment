{
  "tiles": [
    {
      "id": "tab-capture",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "captureTab",
      "color": "#00ffff",
      "icon": "🎵"
    },
    {
      "id": "mic-input",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "toggleMic",
      "color": "#ff0088",
      "icon": "🎤"
    },
    {
      "id": "demo-loops",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "playLoop",
      "color": "#ffff00",
      "icon": "▶"
    },
    {
      "id": "file-input",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "loadFile",
      "color": "#ff8800",
      "icon": "📁"
    },
    {
      "id": "wave-speed",
      "type": "slider",
      "width": 160,
      "height": 90,
      "min": 0.00005,
      "max": 0.333,
      "default": 0.3,
      "variable": "waveSpeed",
      "color": "#4444ff",
      "curve": 4.0
    },
    {
      "id": "damping",
      "type": "slider",
      "width": 160,
      "height": 90,
      "min": 0,
      "max": 0.01,
      "default": 0.002,
      "variable": "damping",
      "color": "#ff4444",
      "curve": 5.0
    },
    {
      "id": "gain",
      "type": "slider",
      "width": 160,
      "height": 90,
      "min": 0.5,
      "max": 15.0,
      "default": 3.0,
      "variable": "actuatorGain",
      "color": "#44ff44"
    },
    {
      "id": "freeze",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "freezePhysics",
      "color": "#00aaff",
      "icon": "⏸"
    },
    {
      "id": "export-heightmap",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "exportHeightmap",
      "color": "#ffaa00",
      "icon": "📷"
    },
    {
      "id": "clear-all",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "clearAll",
      "color": "#ff5555",
      "icon": "×"
    },
    {
      "id": "fullscreen",
      "type": "button",
      "width": 60,
      "height": 60,
      "action": "toggleFullscreen",
      "color": "#ffffff",
      "icon": "⛶"
    },
    {
      "id": "wireframe",
      "type": "toggle",
      "width": 60,
      "height": 60,
      "action": "toggleWireframe",
      "color": "#00ffaa",
      "icon": "⬡"
    },
    {
      "id": "smoothing",
      "type": "slider",
      "width": 160,
      "height": 90,
      "min": 0.001,
      "max": 0.3,
      "default": 0.3,
      "variable": "displaySmoothing",
      "color": "#ff88ff",
      "curve": 2.0
    },
    {
      "id": "grid-size",
      "type": "slider",
      "width": 160,
      "height": 90,
      "min": 20,
      "max": 150,
      "default": 100,
      "variable": "gridResolution",
      "color": "#aa44ff"
    },
    {
      "id": "keyboard",
      "type": "keyboard",
      "width": 320,
      "height": 100,
      "action": "toggleKeyboard",
      "color": "#00e5ff"
    },
    {
      "id": "mini-membrane",
      "type": "mini-membrane",
      "width": 120,
      "height": 120,
      "resizable": true
    }
  ],
  "actuatorProperties": {
    "size": {
      "min": 1.0,
      "max": 5.0,
      "default": 2.0
    },
    "height": {
      "min": 0.0,
      "max": 20.0,
      "default": 2.0
    },
    "transparency": {
      "min": 0.3,
      "max": 1.0,
      "default": 0.7
    }
  },
  "membraneGradient": {
    "range": [-10, 10],
    "colorScale": "interpolateSpectral"
  }
}
